{% extends "base.html.twig" %}

{% block content %}
  <article class="prose">
    <header class="hero">
      <div>
        <p class="eyebrow">{{ page.eyebrow }}</p>
        <h1>{{ page.title }}</h1>
        <p class="lede">{{ page.intro }}</p>
      </div>
    </header>
    {% for section in page.sections %}
      <section>
        <h2>{{ section.heading }}</h2>
        {% for paragraph in section.paragraphs|default([]) %}<p>{{ paragraph }}</p>{% endfor %}
        {% if section.items is defined %}
          <ul>{% for item in section.items %}<li>{{ item }}</li>{% endfor %}</ul>
        {% endif %}
        {% if section.links is defined %}
          <ul>{% for link in section.links %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}</ul>
        {% endif %}
        {% if section.example is defined %}
          <div class="example-grid" aria-label="{{ section.example.label }}">
            {% for tile in section.example.tiles %}<span class="example-tile example-tile--{{ tile.state }}">{{ tile.letter }}</span>{% endfor %}
          </div>
          <p>{{ section.example.explanation }}</p>
        {% endif %}
      </section>
    {% endfor %}
    {% if page.cta is defined %}<p><a class="button" href="{{ page.cta.url }}">{{ page.cta.label }}</a></p>{% endif %}
    {% if current_route in ['how-to-play', 'strategy'] %}
      <section>
        <h2>Related Wordle help</h2>
        <p>
          <a href="/">Today’s Wordle hints</a>,
          <a href="/wordle-solver/">Wordle solver</a>,
          <a href="/wordle-answers/">past Wordle answers</a>{% if current_route == 'how-to-play' %}, and <a href="/wordle-strategy/">Wordle strategy tips</a>{% else %}, and <a href="/how-to-play-wordle/">Wordle rules</a>{% endif %}.
        </p>
      </section>
    {% endif %}
  </article>
{% endblock %}

{% extends "base.html.twig" %}

{% block content %}
  <article data-dated-page data-page-date="{{ record.puzzle_date }}">
    <header class="hero content-measure">
      <div>
        <p class="eyebrow" data-date-relation>Dated Wordle puzzle</p>
        <h1>Wordle #{{ record.puzzle_number }} hints and answer for {{ full_date }}</h1>
        <p class="lede">This page stays fixed to {{ record.puzzle_date }}. It will not redirect you away from a deliberately selected archive date.</p>
      </div>
      <p class="notice notice--warning" data-future-date-warning hidden></p>
      <div class="action-row">
        <a class="button button--secondary" data-local-today-link hidden href="/">Go to your local day</a>
        <a class="button button--quiet" data-date-update hidden href="/">A new local date is available</a>
      </div>
    </header>

    {% if record.correction_notice is defined and record.correction_notice %}
      <p class="notice notice--warning"><strong>Correction:</strong> {{ record.correction_notice }}</p>
    {% endif %}

    {% include "partials/answer.html.twig" with {id_suffix: '-dated'} %}

    <nav class="archive-nav section" aria-label="Adjacent puzzle dates">
      {% if previous_record %}<a rel="prev" href="/wordle-answers/{{ previous_record.puzzle_date }}/">← {{ previous_record.puzzle_date }}</a>{% endif %}
      <a href="/wordle-answers/">All published answers</a>
      {% if next_record %}<a rel="next" href="/wordle-answers/{{ next_record.puzzle_date }}/">{{ next_record.puzzle_date }} →</a>{% endif %}
    </nav>

    <section class="section card content-measure" aria-labelledby="dated-next-step-heading">
      <h2 id="dated-next-step-heading">Need help with another Wordle?</h2>
      <p>Try the <a href="/wordle-solver/">Wordle solver</a> with your green, yellow and grey tiles, return to <a href="/">today’s Wordle hint</a>, or review the <a href="/how-to-play-wordle/">Wordle rules</a>.</p>
    </section>
  </article>
{% endblock %}

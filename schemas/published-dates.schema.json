{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordle-hit-today.invalid/schemas/published-dates.schema.json",
  "title": "Public published-date manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "built_at_utc",
    "homepage_default_date",
    "available_dates",
    "archive_indexes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "built_at_utc": { "type": "string", "format": "date-time" },
    "homepage_default_date": { "type": "string", "format": "date" },
    "available_dates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "number", "url"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "number": { "type": "integer", "minimum": 0 },
          "url": {
            "type": "string",
            "pattern": "^/wordle-answers/[0-9]{4}-[0-9]{2}-[0-9]{2}/$"
          }
        }
      }
    },
    "archive_indexes": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]{4}$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^/assets/data/archive-[0-9]{4}\\.[a-f0-9]{12}\\.json$"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordle-hit-today.invalid/schemas/record.schema.json",
  "title": "Validated puzzle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "puzzle_date",
    "puzzle_number",
    "upstream_id",
    "solution",
    "source_url",
    "fetched_at_utc",
    "source_checked_at_utc",
    "validation_method",
    "content_revision",
    "record_state",
    "hint_values",
    "definition_reference",
    "content_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["fixture", "production"] },
    "puzzle_date": { "type": "string", "format": "date" },
    "puzzle_number": { "type": "integer", "minimum": 0 },
    "upstream_id": { "type": ["string", "integer"], "maxLength": 128 },
    "solution": { "type": "string", "pattern": "^[A-Z]{5}$" },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "fetched_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "source_checked_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "validation_method": {
      "enum": ["synthetic_fixture", "nyt_structural_validation"]
    },
    "content_revision": { "type": "integer", "minimum": 1 },
    "record_state": { "enum": ["validated", "published", "quarantined"] },
    "hint_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vowel_occurrences", "has_repeats"],
      "properties": {
        "vowel_occurrences": { "type": "integer", "minimum": 0, "maximum": 5 },
        "has_repeats": { "type": "boolean" }
      }
    },
    "definition_reference": { "type": ["string", "null"], "maxLength": 200 },
    "correction_notice": { "type": "string", "minLength": 1, "maxLength": 500 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

{
  "schema_version": 1,
  "mode": "fixture",
  "site_name": "Wordle Hit Today",
  "canonical_origin": "https://example.invalid",
  "homepage_fallback_timezone": "UTC",
  "visitor_date_mode": "device_local",
  "puzzle_number_anchor": null,
  "source_poll_minutes": 5,
  "archive_page_size": 50,
  "public_output": "var/site",
  "private_storage": "var/private",
  "source": {
    "host": "www.nytimes.com",
    "path_pattern": "/svc/wordle/v2/{date}.json",
    "connect_timeout_seconds": 10,
    "total_timeout_seconds": 20,
    "maximum_response_bytes": 65536
  },
  "contact_address": null,
  "monitoring": {
    "status_path": "var/private/status.json",
    "heartbeat_stale_minutes": 15,
    "eligible_date_pending_minutes": 30
  },
  "backup": {
    "local_path": "var/backups",
    "daily_copies": 7,
    "weekly_copies": 4
  },
  "theme": {
    "background": "#FAFAF7",
    "text": "#17211B",
    "accent": "#256D45"
  }
}

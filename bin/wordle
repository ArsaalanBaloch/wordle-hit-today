#!/usr/bin/env php
<?php

declare(strict_types=1);

use WordleHitToday\Console\ApplicationFactory;

$projectRoot = dirname(__DIR__);
$autoload = $projectRoot.'/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Dependencies are missing. Run composer install.\n");
    exit(10);
}
require $autoload;

exit(ApplicationFactory::create($projectRoot)->run());

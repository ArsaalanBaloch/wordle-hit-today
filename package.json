{
  "name": "wordle-hit-today-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "lint": "eslint assets/js scripts tests",
    "format:check": "prettier --check \"{assets,scripts,tests}/**/*.{css,js,json}\" \"*.{json,md}\" \"config/**/*.json\" \"schemas/**/*.json\"",
    "prepare:production-data": "node scripts/prepare-production-data.mjs",
    "build": "node scripts/build.mjs",
    "test:unit": "vitest run tests/js",
    "test:browser": "playwright test --project=browser-chromium --project=responsive",
    "test:a11y": "playwright test --project=a11y",
    "test:seo": "playwright test --project=seo",
    "test:performance": "playwright test --project=performance",
    "audit:seo": "node scripts/seo-audit.mjs var/site",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "audit": "npm audit --audit-level=high",
    "check:static": "npm run lint && npm run format:check && npm run scan:secrets && npm run audit && npm run test:unit",
    "check:browser": "npm run test:browser && npm run test:a11y && npm run test:seo && npm run test:performance && npm run audit:seo",
    "check": "npm run check:static && npm run build && npm run check:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
